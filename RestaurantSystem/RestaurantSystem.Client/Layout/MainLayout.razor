@inherits LayoutComponentBase
@using RestaurantSystem.Client.Components
@using Microsoft.AspNetCore.Components.Authorization

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span>Привет, @context.User.Identity?.Name!</span>
                    <a href="logout" class="ms-3">Выйти</a>
                </Authorized>
                <NotAuthorized>
                    <a href="login">Вход</a>
                    <a href="register" class="ms-3">Регистрация</a>
                </NotAuthorized>
            </AuthorizeView>
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">О программе</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<NotificationSystem />

<div id="blazor-error-ui">
    Произошла непредвиденная ошибка.
    <a href="." class="reload">Обновить</a>
    <span class="dismiss">🗙</span>
</div>
