@inherits LayoutComponentBase
@using RestaurantSystem.Client.Components
@using Microsoft.AspNetCore.Components.Authorization
@using RestaurantSystem.Client.Auth
@using Blazored.LocalStorage
@inject ILocalStorageService LocalStorage
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager NavManager

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between">
            <div>
                <!-- Left side of top row -->
            </div>
            <div class="d-flex align-items-center">
                <AuthorizeView>
                    <Authorized>
                        <span class="me-3">Привет, <b>@context.User.Identity?.Name</b>!</span>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="HandleLogout">Выйти</button>
                    </Authorized>
                    <NotAuthorized>
                        <a href="login" class="btn btn-sm btn-primary me-2">Вход</a>
                        <a href="register" class="btn btn-sm btn-outline-success">Регистрация</a>
                    </NotAuthorized>
                </AuthorizeView>
                <a href="https://learn.microsoft.com/aspnet/core/" target="_blank" class="ms-3">О программе</a>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<NotificationSystem />

<div id="blazor-error-ui">
    Произошла непредвиденная ошибка.
    <a href="." class="reload">Обновить</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private async Task HandleLogout()
    {
        await LocalStorage.RemoveItemAsync("authToken");
        AuthStateProvider.NotifyUserLogout();
        NavManager.NavigateTo("/");
    }
}
